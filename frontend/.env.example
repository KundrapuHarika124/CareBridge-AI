# Copy to frontend/.env only if you need to change a default. No secrets belong here:
# everything in this file is shipped to the browser.

# API path. Keep the default; /api is proxied to the backend in dev and in production.
VITE_API_BASE_URL=/api/v1

# Azure neural voices used for spoken replies (only when the backend has speech configured).
VITE_TTS_VOICE_TE=te-IN-ShrutiNeural
VITE_TTS_VOICE_EN=en-IN-NeerjaNeural
