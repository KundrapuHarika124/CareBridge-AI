# Copy to backend/.env and fill in. Never commit the real file.

# development | test | production. Mock providers are refused in production.
APP_ENV=development

# PostgreSQL. This default matches docker-compose.yml. For Supabase, paste the
# "connection pooling" URI from the project settings (postgresql://...).
DATABASE_URL=postgresql+psycopg://carebridge:carebridge@localhost:5432/carebridge

# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=replace-with-a-long-random-value-of-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Comma-separated browser origins allowed to call the API directly.
CORS_ORIGINS=http://localhost:5173

LOG_LEVEL=INFO
RUN_JOBS=true

# Assistant language model: none | gemini | mock (mock is for development only).
# With "none" the assistant works in guided mode and everything else is unaffected.
LLM_PROVIDER=none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Voice: none | azure | mock. With "none" the microphone is hidden and typing is used.
SPEECH_PROVIDER=none
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Password reset email: none | mock (mock is development/test only).
EMAIL_PROVIDER=none
PASSWORD_RESET_EXPIRE_MINUTES=30
