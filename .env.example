# Used only by docker-compose.yml. Copy to .env in this folder. Never commit the real file.
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=replace-with-a-long-random-value

# Optional providers. Leave as "none" to run with zero external accounts.
LLM_PROVIDER=none
GEMINI_API_KEY=
SPEECH_PROVIDER=none
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
